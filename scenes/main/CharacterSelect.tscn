[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/character_select.gd" id="1_cs"]
[ext_resource type="Texture2D" path="res://assets/ui/main_menu_bg.png" id="2_bg"]

[node name="CharacterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
